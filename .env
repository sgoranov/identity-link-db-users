# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=prod
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
APP_SECRET_FILE=/run/secrets/app_secret
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://%env(default:fallback_db_user:file:DB_USER_FILE)%:%env(default:fallback_db_password:file:DB_PASSWORD_FILE)%@%env(DB_HOST)%:%env(DB_PORT)%/%env(DB_NAME)%?serverVersion=15&charset=utf8"
DB_NAME=identity-link-db-users
DB_USER_FILE=/run/secrets/db_user
DB_PASSWORD_FILE=/run/secrets/db_password
DB_HOST=identity-link-database-server
DB_PORT=5432

###< doctrine/doctrine-bundle ###

# JWKS (JSON Web Key Set) endpoint used in AccessTokenHandler
# to verify the signature and claims of incoming JWT access tokens
JWT_JWKS_URI=http://identity-link-core:9000/jwks

# Canonical URL identifying this service as the JWT issuer and protected-resource audience.
# Client registrations targeting this API must use the same value as their audience.
JWT_URL=https://example.com/identity-link

# The full URL to redirect the user to after a successful password reset.
# This can be an external link or a different frontend application.
RESET_PASSWORD_REDIRECT_URL=https://example.com/login/password/{id}

# Feature toggle for enabling the Reset Password functionality
FEATURE_RESET_PASSWORD_ENABLED=true

# Redis server connection string
REDIS_DSN=redis://identity-link-redis:6379?prefix=db_users

# Enable or disable password strength validation.
# Set to "true" to enable strong password checks (e.g., length, complexity).
FEATURE_PASSWORD_VALIDATION_ENABLED=true

###> symfony/mailer ###
MAILER_DSN=smtp://user%40domain.com:pass@identity-link-smtp-server:1025
MAILER_FROM_ADDRESS=no-reply@example.com
MAILER_FROM_NAME='Identity Link'
###< symfony/mailer ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###
